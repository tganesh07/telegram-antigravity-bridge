# =========================================================================
# PLUGGABLE ANTI-GRAVITY MESSAGING BRIDGE CONFIGURATION
# =========================================================================

# -------------------------------------------------------------------------
# Provider Selector
# -------------------------------------------------------------------------
# Currently supported: telegram
# (Future providers: whatsapp, signal, etc.)
MESSAGING_PROVIDER=telegram

# -------------------------------------------------------------------------
# Telegram Provider Settings
# -------------------------------------------------------------------------
# Get your bot token by messaging @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram user ID to restrict access to ONLY your phone.
# You can find this by sending any message to @userinfobot on Telegram.
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# -------------------------------------------------------------------------
# Anti-Gravity Defaults
# -------------------------------------------------------------------------
# Default model tier to use for new conversations (pro, flash, flash_lite)
DEFAULT_MODEL=flash
